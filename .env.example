# CMC Platform (CSHSP) — 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 절대 커밋하지 않는다(.gitignore 처리됨).

# 운영 데이터 디렉토리 (절대경로)
CSHSP_DATA_DIR=

# Claude API 키 (선택 — 미설정 시 규칙 기반 Mock 모드로 자동 동작)
# 주의: 실제 값은 서버 환경변수로만 설정. 코드/문서/채팅에 절대 기록하지 말 것.
ANTHROPIC_API_KEY=

# Claude 모델 (선택, 기본값: claude-opus-4-8)
CSHSP_CLAUDE_MODEL=

# 채팅 Rate Limit — "요청수/시간(초)" 형식 (선택, 기본값: 30/60)
CSHSP_CHAT_RATE=

# Python 표준출력 인코딩 (Windows 운영 권장)
PYTHONIOENCODING=utf-8

# ── Sprint8 Commit8-2: 관리자 인증 환경설정 ──
# CSHSP_ENV: development(기본값) | test | staging | production
# production으로 설정하면 X-User-Id Mock 인증이 다른 값과 무관하게 완전히
# 차단된다(Fail-Closed). 값을 비워두거나 오타를 내면 development로 간주되므로,
# 운영 배포 시에는 반드시 정확히 "production"으로 설정해야 한다.
CSHSP_ENV=development

# CSHSP_ALLOW_MOCK_AUTH: 1(허용) 또는 미설정(기본값, 차단)
# CSHSP_ENV != production 이면서 이 값이 1/true/yes일 때만 X-User-Id Mock 인증이
# 동작한다. 개발·테스트 환경에서만 설정하고, 운영/Staging에는 절대 설정하지
# 않는다. **주의(Decision Required)**: Mock 인증이 허용된 상태에서는 승인·거절
# 등 상태변경 API도 CSRF 검증 없이 그대로 실행되며 별도의 Write 차단 장치가
# 없다 — Mock을 허용하는 환경에는 반드시 실제 운영 Google Sheets에 연결된
# CSHSP_GAS_WEBAPP_URL을 함께 설정하지 않는다(상세: Sprint8 Commit8-2 PM
# 보완검증 보고서 §Mock/CSRF 재평가).
CSHSP_ALLOW_MOCK_AUTH=

# CSHSP_COOKIE_INSECURE_DEV: 1 또는 미설정(기본값, Secure=True 유지)
# 로컬 HTTP(비HTTPS) 개발 환경에서만 1로 설정한다. production/staging에서는
# CSHSP_ENV 값과 무관하게 절대 설정하지 않는다 — 설정해도 production/staging
# 판정 시에는 무시되고 Secure=True가 강제된다(코드 레벨 Fail-Closed).
CSHSP_COOKIE_INSECURE_DEV=
