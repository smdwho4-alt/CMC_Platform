# CMC Platform (CSHSP) — 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 절대 커밋하지 않는다(.gitignore 처리됨).

# 운영 데이터 디렉토리 (절대경로)
CSHSP_DATA_DIR=

# Claude API 키 (선택 — 미설정 시 규칙 기반 Mock 모드로 자동 동작)
# 주의: 실제 값은 서버 환경변수로만 설정. 코드/문서/채팅에 절대 기록하지 말 것.
ANTHROPIC_API_KEY=

# Claude 모델 (선택, 기본값: claude-opus-4-8)
CSHSP_CLAUDE_MODEL=

# 채팅 Rate Limit — "요청수/시간(초)" 형식 (선택, 기본값: 30/60)
CSHSP_CHAT_RATE=

# Python 표준출력 인코딩 (Windows 운영 권장)
PYTHONIOENCODING=utf-8
